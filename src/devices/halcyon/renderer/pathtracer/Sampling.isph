#pragma once

// The pathtracer's sample generator: an ISPC port of Typhoon's
// renderer/sampling/sampling.h (ty::Sampler, ty::SampleDomain) over OpenQMC
// 0.7.1's blue-noise Sobol sampler (oqmc::SobolBnSampler), which Typhoon uses.
// It produces the same numbers as the originals, bit for bit, so images can
// be compared with Typhoon's sample for sample.
//
// Every random decision of a path draws from a named domain derived from the
// pixel sample's root domain (SampleDomain_root()): fork() a child per
// decision, chain() one per path event or loop index, split() or distrib()
// for several samples of one decision. Domains are independent of the order
// in which they are derived or drawn, so a decision that isn't taken shifts
// no other's numbers. Each domain gives up to 4 dimensions.
//
// OpenQMC's blue-noise key and rank tables are data from OpenQMC's own
// sources, compiled into the device by SobolBnTables.cpp.

#include "shading/halcyon_math.isph"

// Domain keys (Typhoon's ty::SampleDomainKey, and halcyon's) /////////////////

enum SampleDomainKey
{
  SAMPLE_DOMAIN_PIXEL = 0x0001,
  SAMPLE_DOMAIN_CAMERA_JITTER = 0x0010,
  SAMPLE_DOMAIN_CAMERA_LENS = 0x0011,
  SAMPLE_DOMAIN_AMBIENT_OCCLUSION = 0x001f,
  SAMPLE_DOMAIN_AMBIENT_OCCLUSION_SAMPLE = 0x0020,
  SAMPLE_DOMAIN_AMBIENT_OCCLUSION_SHUFFLE = 0x0021,
  SAMPLE_DOMAIN_PATH_BOUNCE = 0x0100,
  SAMPLE_DOMAIN_PRESENCE = 0x0110,
  SAMPLE_DOMAIN_WAVELENGTH = 0x0111,
  SAMPLE_DOMAIN_BSDF_SAMPLE = 0x0120,
  SAMPLE_DOMAIN_DIRECT_LIGHTING = 0x012f,
  SAMPLE_DOMAIN_DIRECT_LIGHT_SELECT = 0x0130,
  SAMPLE_DOMAIN_DIRECT_LIGHT_SAMPLE = 0x0131,
  SAMPLE_DOMAIN_RUSSIAN_ROULETTE = 0x0140,
  SAMPLE_DOMAIN_MEDIUM_CHANNEL = 0x0200,
  SAMPLE_DOMAIN_MEDIUM_FREE_FLIGHT = 0x0201,
  SAMPLE_DOMAIN_MEDIUM_DIRECT_LIGHTING = 0x020f,
  SAMPLE_DOMAIN_MEDIUM_DIRECT_LIGHT_SELECT = 0x0210,
  SAMPLE_DOMAIN_MEDIUM_DIRECT_LIGHT_SAMPLE = 0x0211,
  SAMPLE_DOMAIN_MEDIUM_RUSSIAN_ROULETTE = 0x0220,
  SAMPLE_DOMAIN_MEDIUM_PHASE = 0x0230,
  SAMPLE_DOMAIN_SSS_ENTRY = 0x0300,
  SAMPLE_DOMAIN_SSS_ENTRY_DIRECTION = 0x0301,
  SAMPLE_DOMAIN_SSS_BOUNCE = 0x0310,
  SAMPLE_DOMAIN_SSS_CHANNEL = 0x0320,
  SAMPLE_DOMAIN_SSS_GUIDE_CHOICE = 0x0321,
  SAMPLE_DOMAIN_SSS_BACKWARD_CHOICE = 0x0322,
  SAMPLE_DOMAIN_SSS_PHASE_DIRECTION = 0x0323,
  SAMPLE_DOMAIN_SSS_FREE_FLIGHT = 0x0324,
  // halcyon's own, without a Typhoon counterpart (Typhoon has no grid
  // volumes; VolumeTransport.isph): a path segment's free flights through
  // the transferFunction1D volumes (chained per tentative collision), the
  // choice of the volume a collision scatters in, the phase function's
  // sample, and a shadow ray's or emitter-only segment's ratio tracking
  // (chained per tentative collision)
  SAMPLE_DOMAIN_VOLUME_FREE_FLIGHT = 0x1000,
  SAMPLE_DOMAIN_VOLUME_SCATTER_CHOICE = 0x1001,
  SAMPLE_DOMAIN_VOLUME_PHASE = 0x1002,
  SAMPLE_DOMAIN_VOLUME_RATIO_TRACKING = 0x1003
};

// OpenQMC's blue-noise tables (oqmc/bntables.h, sobol): 256 x 256 pixels,
// indexed x | y << 8. Defined in SobolBnTables.cpp.
#define SAMPLE_TABLE_SIZE 65536
extern uniform const uint32 halcyon_sobolBnKeyTable[SAMPLE_TABLE_SIZE];
extern uniform const uint32 halcyon_sobolBnRankTable[SAMPLE_TABLE_SIZE];

// A domain: OpenQMC's State64Bit. sampleId and pixelId are 16-bit values.
struct SampleDomain
{
  uint32 patternId;
  uint32 sampleId;
  uint32 pixelId;
};

// Bit operations (oqmc/pcg.h, reverse.h, rotate.h, permute.h) ////////////////

inline uint32 Sampling_pcgStateTransition(uint32 state)
{
  return state * 747796405u + 2891336453u;
}

inline uint32 Sampling_pcgOutput(uint32 state)
{
  state ^= state >> (4 + (state >> 28));
  state *= 277803737u;
  state ^= state >> 22;
  return state;
}

inline uint32 Sampling_reverseBits32(uint32 v)
{
  v = ((v & 0xaaaaaaaau) >> 1) | ((v & 0x55555555u) << 1);
  v = ((v & 0xccccccccu) >> 2) | ((v & 0x33333333u) << 2);
  v = ((v & 0xf0f0f0f0u) >> 4) | ((v & 0x0f0f0f0fu) << 4);
  v = ((v & 0xff00ff00u) >> 8) | ((v & 0x00ff00ffu) << 8);
  return (v >> 16) | (v << 16);
}

inline uint32 Sampling_rotateBytes(uint32 value, uniform int bytes)
{
  const uniform uint32 bits = bytes * 8;
  return value >> (bits & 31) | value << (-bits & 31);
}

inline uint32 Sampling_laineKarrasPermutation(uint32 value, uint32 seed)
{
  value ^= value * 0x3d20adeau;
  value += seed;
  value *= (seed >> 16) | 1u;
  value ^= value * 0x05526c56u;
  value ^= value * 0x53a22864u;
  return value;
}

// Sobol (oqmc/owen.h) ////////////////////////////////////////////////////////

// Generator matrices of Sobol dimensions 1-3, columns for index bits 0-15
// (dimension 0 is the bit reversal); OpenQMC's sobolReversedIndex() tables
static const uniform uint32 SAMPLING_SOBOL_MATRICES[3][16] = {
    {0xffff, 0x5555, 0x3333, 0x1111, 0x0f0f, 0x0505, 0x0303, 0x0101,
        0x00ff, 0x0055, 0x0033, 0x0011, 0x000f, 0x0005, 0x0003, 0x0001},
    {0xaa09, 0x7706, 0x3903, 0x1601, 0x09aa, 0x0677, 0x0339, 0x0116,
        0x00a3, 0x0071, 0x003a, 0x0017, 0x0009, 0x0006, 0x0003, 0x0001},
    {0xa0c3, 0x4041, 0x302d, 0x101e, 0x0b67, 0x079a, 0x02a4, 0x011b,
        0x00c9, 0x0045, 0x002e, 0x001f, 0x000a, 0x0004, 0x0003, 0x0001}};

// Sobol dimension 'dimension' of the 16-bit 'index', bit-reversed
inline uint32 Sampling_sobolReversedIndex(uint32 index, uniform int dimension)
{
  if (dimension == 0)
    return Sampling_reverseBits32(index) >> 16;
  uint32 sample = 0;
  for (uniform int i = 0; i < 16; i++) {
    if (index & (1u << i))
      sample ^= SAMPLING_SOBOL_MATRICES[dimension - 1][i];
  }
  return sample;
}

// The first 'size' dimensions of the shuffled, scrambled Sobol point 'index'
// for 'seed' (shuffledScrambledSobol())
inline void Sampling_shuffledScrambledSobol(
    uint32 index, uint32 seed, uniform int size, uint32 sample[4])
{
  index = Sampling_laineKarrasPermutation(Sampling_reverseBits32(index), seed);
  for (uniform int i = 0; i < size; i++) {
    const uint32 s = Sampling_sobolReversedIndex(index >> 16, i);
    sample[i] = Sampling_reverseBits32(Sampling_laineKarrasPermutation(
        s, Sampling_rotateBytes(seed, i)));
  }
}

// Domains ////////////////////////////////////////////////////////////////////

// The frame seed (ty::ResolveFrameSeed()): 'configuredSeed' unless it is -1,
// else the bits of the scene frame
inline uniform uint32 Sampling_resolveFrameSeed(
    uniform int configuredSeed, uniform float sceneFrame)
{
  return configuredSeed != -1 ? (uniform uint32)configuredSeed
                              : intbits(sceneFrame);
}

// The root domain of sample 'sampleIndex' (>= 0) of pixel (x, y)
// (ty::Sampler(...).RootDomain())
inline SampleDomain SampleDomain_root(
    uint32 frameSeed, int x, int y, int sampleIndex)
{
  const int frame = (int)(frameSeed & 0x7fffffffu);
  SampleDomain d;
  d.patternId =
      Sampling_pcgStateTransition(0) + (uint32)(frame + (sampleIndex >> 16));
  d.sampleId = sampleIndex & 0xffff;
  d.pixelId = (x & 0xff) | ((y & 0xff) << 8);
  return d;
}

// OpenQMC's newDomain()
inline SampleDomain Sampling_newDomain(SampleDomain d, int key)
{
  d.patternId = Sampling_pcgStateTransition(d.patternId + (uint32)key);
  return d;
}

// A child domain for one decision (ty::SampleDomain::Fork())
inline SampleDomain SampleDomain_fork(SampleDomain d, int key)
{
  return Sampling_newDomain(d, key);
}

// Sample 'index' of 'size' of a decision taken 'size' times per pixel sample,
// well distributed locally and globally; 'size' must be the same for every
// pixel sample (ty::SampleDomain::Split())
inline SampleDomain SampleDomain_split(
    SampleDomain d, int key, int size, int index)
{
  const int i = (int)d.sampleId * max(size, 1) + max(index, 0);
  SampleDomain r = Sampling_newDomain(Sampling_newDomain(d, key), i >> 16);
  r.sampleId = i & 0xffff;
  return r;
}

// Sample 'index' of a decision taken a varying number of times, well
// distributed locally (ty::SampleDomain::Distrib())
inline SampleDomain SampleDomain_distrib(SampleDomain d, int key, int index)
{
  index = max(index, 0);
  SampleDomain r = Sampling_newDomain(
      Sampling_newDomain(Sampling_newDomain(d, key), index >> 16),
      (int)d.sampleId);
  r.sampleId = index & 0xffff;
  return r;
}

// Iteration 'index' of a loop, well distributed globally
// (ty::SampleDomain::Chain())
inline SampleDomain SampleDomain_chain(SampleDomain d, int key, int index)
{
  return Sampling_newDomain(Sampling_newDomain(d, key), max(index, 0));
}

// Draws ///////////////////////////////////////////////////////////////////////

// The first 'size' (1-4) dimensions of the domain's point as 32-bit integers
// (SobolBnImpl::drawSample())
inline void SampleDomain_drawBits(
    const SampleDomain &d, uniform int size, uint32 sample[4])
{
  // the pixel's table entry, shifted toroidally by the pattern
  const uint32 shift = Sampling_pcgOutput(d.patternId);
  const uint32 x = (d.pixelId + shift) & 0xff;
  const uint32 y = ((d.pixelId >> 8) + (shift >> 8)) & 0xff;
  const uint32 entry = x | (y << 8);
#pragma ignore warning(perf)
  const uint32 key = halcyon_sobolBnKeyTable[entry];
#pragma ignore warning(perf)
  const uint32 rank = halcyon_sobolBnRankTable[entry];
  Sampling_shuffledScrambledSobol(d.sampleId ^ rank, key, size, sample);
}

// An integer in [0, 2^32) to a float in [0, 1) (oqmc::uintToFloat())
inline float Sampling_uintToFloat(uint32 value)
{
  return min((float)value * 2.3283064365386962890625e-10f,
      0.999999940395355224609375f);
}

inline float SampleDomain_draw1D(const SampleDomain &d)
{
  uint32 s[4];
  SampleDomain_drawBits(d, 1, s);
  return Sampling_uintToFloat(s[0]);
}

inline float2 SampleDomain_draw2D(const SampleDomain &d)
{
  uint32 s[4];
  SampleDomain_drawBits(d, 2, s);
  return make_float2(Sampling_uintToFloat(s[0]), Sampling_uintToFloat(s[1]));
}

inline float3 SampleDomain_draw3D(const SampleDomain &d)
{
  uint32 s[4];
  SampleDomain_drawBits(d, 3, s);
  return make_float3(Sampling_uintToFloat(s[0]),
      Sampling_uintToFloat(s[1]),
      Sampling_uintToFloat(s[2]));
}

inline float4 SampleDomain_draw4D(const SampleDomain &d)
{
  uint32 s[4];
  SampleDomain_drawBits(d, 4, s);
  return make_float4(Sampling_uintToFloat(s[0]),
      Sampling_uintToFloat(s[1]),
      Sampling_uintToFloat(s[2]),
      Sampling_uintToFloat(s[3]));
}
